{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A drink item in the menu",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "prices": {
          "type": "object",
          "properties": {
            "M": { "type": "number" },
            "L": { "type": "number" }
          }
        },
        "image": { "type": "string" },
        "isAvailable": { "type": "boolean" }
      },
      "required": ["name", "category", "prices"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "name": { "type": "string" },
              "quantity": { "type": "number" },
              "price": { "type": "number" },
              "size": { "type": "string" },
              "sugar": { "type": "string" },
              "ice": { "type": "string" }
            }
          }
        },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "paid", "preparing", "completed", "cancelled"] },
        "customerInfo": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "phone": { "type": "string" }
          }
        },
        "paymentId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["items", "totalAmount", "status", "createdAt"]
    }
  },
  "firestore": {
    "products": {
      "schema": "Product",
      "description": "Store tea menu items"
    },
    "orders": {
      "schema": "Order",
      "description": "Store customer orders"
    }
  }
}
